# ==========================================
# GroVastra Root .gitignore
# ==========================================

docs/

# Secrets & Environment Files (CRITICAL: Never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js

# Build Outputs
dist/
build/
backend/dist/
frontend/.next/
frontend/out/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Testing & Coverage
coverage/
.nyc_output/
*.lcov

# IDE & OS Artifacts
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# TypeScript Cache
*.tsbuildinfo
next-env.d.ts
