{
  "name": "grovastra-backend",
  "version": "1.0.0",
  "description": "GroVastra Modular Monolith Backend: Auto Campaigns & Social Engine",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker:planner": "tsx watch src/workers/planner.ts",
    "worker:executor": "tsx watch src/workers/executor.ts",
    "worker:events": "tsx watch src/workers/events.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "luxon": "^3.5.0",
    "mongoose": "^8.9.5",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.7",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
