# GroVastra backend environment. Copy to .env. NEVER commit real values.
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/grovastra?replicaSet=rs0
DEFAULT_TENANT_ID=shop_demo
LOG_LEVEL=info

# Secrets: no defaults exist. Generate each with: openssl rand -hex 32
# All REQUIRED in production; startup fails if missing or placeholder-like.
ENCRYPTION_KEY=
JWT_SECRET=
INTERNAL_API_KEY=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Local development only. Rejected in production.
ALLOW_INSECURE_DEV_AUTH=false

# WhatsApp: 'mock' or 'sandbox'. 'live' needs WHATSAPP_CONNECTION_ID from the integration developer.
WHATSAPP_MODE=mock
WHATSAPP_CONNECTION_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
