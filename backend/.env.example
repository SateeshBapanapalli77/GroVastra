# ==========================================
# GroVastra Backend Environment Configuration
# ==========================================
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/grovastra
ENCRYPTION_KEY=grovastra_32_byte_secret_key_prod_01
DEFAULT_TENANT_ID=shop_padmavati_handlooms
LOG_LEVEL=info

# ==========================================
# WhatsApp Multi-Tier Delivery Adapter Config
# ==========================================
# Options: 'mock' (default offline simulation) or 'sandbox' (live Meta test number)
WHATSAPP_MODE=sandbox

# Free Meta WhatsApp Cloud API Developer Sandbox Credentials:
# (Obtain these from developers.facebook.com > WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=

# Local Webhook Security
WHATSAPP_WEBHOOK_VERIFY_TOKEN=grovastra_handloom_secure_verify_token_2026
